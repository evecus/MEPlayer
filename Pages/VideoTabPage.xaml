<UserControl x:Class="MEPlayer.Pages.VideoTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 只放根 UserControl 与外层 Grid；侧栏 / 工具栏 / 网格等内部控件均在 code-behind 动态构建，
         因为侧栏路径列表与缩略图网格都需要随扫描结果响应式更新。 -->
    <Grid x:Name="RootGrid"/>
</UserControl>
