<UserControl x:Class="MEPlayer.Pages.MusicPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource M3.Background}">
    <!-- 只放根 UserControl 与外层 Grid；封面区 / 歌词区 / 控制条 / 队列面板均在 code-behind 动态构建，
         因为歌词滚动、队列展开/收起、播放状态等都需要响应式更新。 -->
    <Grid x:Name="RootGrid"/>
</UserControl>
