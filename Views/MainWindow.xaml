<Window x:Class="MEPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:MEPlayer.Pages"
        xmlns:controls="clr-namespace:MEPlayer.Controls"
        Title="MEPlayer"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource M3.Background}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏（对应 Flutter NavigationRail） -->
        <Border Grid.Column="0" Background="{DynamicResource M3.Surface}" Width="72">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" x:Name="NavPanel" Orientation="Vertical" Margin="0,12">
                    <!-- 4 个导航按钮在 code-behind 动态构建 -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容区 + 底部 MiniPlayerBar -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 内容区：4 个 Page 通过 Visibility 切换（对应 Flutter IndexedStack） -->
            <Grid Grid.Row="0" x:Name="ContentGrid">
                <pages:VideoTabPage x:Name="VideoTab"/>
                <pages:IptvTabPage x:Name="IptvTab" Visibility="Collapsed"/>
                <pages:MusicTabPage x:Name="MusicTab" Visibility="Collapsed"/>
                <pages:SettingsPage x:Name="SettingsTab" Visibility="Collapsed"/>
            </Grid>

            <!-- 底部播放栏 -->
            <controls:MiniPlayerBar Grid.Row="1" x:Name="MiniBar"/>
        </Grid>

        <!-- 播放页覆盖层：默认隐藏，打开播放页时覆盖整个窗口（含导航栏 + MiniBar），
             对应 Flutter 端 Get.toNamed push 路由的行为——播放页覆盖主页全部内容，
             用户通过播放页左上角的返回按钮回到主页。 -->
        <ContentControl Grid.Column="0" Grid.ColumnSpan="2" x:Name="PlayerLayer" Visibility="Collapsed"/>
    </Grid>
</Window>
